# Recommended deployment: SiliconFlow OpenAI-compatible API
LLM_PROVIDER=siliconflow
LLM_API_KEY=replace-me
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_BASE_URL=https://api.siliconflow.com/v1
ROUTER_CONFIDENCE=0.78

# fal alternative (OpenRouter endpoint through fal)
# LLM_PROVIDER=fal
# LLM_API_KEY=replace-me
# LLM_MODEL=google/gemini-2.5-flash
# LLM_BASE_URL=https://fal.run/openrouter/router/openai/v1

